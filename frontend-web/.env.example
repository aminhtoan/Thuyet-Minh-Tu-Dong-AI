VITE_API_BASE_URL=http://localhost:8080/api
# Enable only with GROUP_TRANSLATION_ENABLED=true on a single backend process.
VITE_GROUP_TRANSLATION_ENABLED=false
# Development-only gate. Keep OFF until MongoDB replica-set transaction integration passes.
VITE_TRANSCRIPT_SEGMENT_EDIT_ENABLED=false
# Development-only static UI preview. It never calls Voice/TTS APIs and is absent from production routes.
VITE_VOICE_DESIGN_PREVIEW_ENABLED=false
# Read-only development screen; NOT permission to generate. No ordinary API fallback.
VITE_CONTROLLED_TRANSLATION_PREVIEW_ENABLED=false
VITE_CONTROLLED_TRANSLATION_EXECUTION_ENABLED=false
VITE_CONTROLLED_TRANSLATION_ORIGIN=
VITE_CUSTOMER_TRANSLATION_ENABLED=false
