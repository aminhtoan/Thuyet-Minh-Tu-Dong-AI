{
  "name": "frontend-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "design:check": "node ../scripts/customer-design-sync.mjs",
    "design:sync": "node ../scripts/customer-design-sync.mjs --write",
    "prebuild": "npm run design:check",
    "pretypecheck": "npm run design:check",
    "dev": "vite",
    "test": "node --experimental-strip-types --experimental-transform-types --test tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
