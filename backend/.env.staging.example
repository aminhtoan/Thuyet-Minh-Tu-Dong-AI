# Documentation only. Never rename/copy development .env or use shared credentials.
APP_ENV=staging
NODE_ENV=production
PORT=8080
MONGODB_URI=mongodb://staging-db.example.invalid/multilingual_ai_narration_staging
STAGING_DATABASE_NAME=multilingual_ai_narration_staging
# Set acknowledgements only after independent infrastructure/permissions review.
STAGING_ISOLATION_ACK=REQUIRES_MANUAL_REVIEW
STAGING_MEDIA_ACK=REQUIRES_MANUAL_REVIEW
UPLOAD_DIR=/var/lib/narration-staging/media
MAX_UPLOAD_SIZE_MB=200
CORS_ORIGINS=https://customer-staging.example.invalid,https://admin-staging.example.invalid
JWT_ACCESS_SECRET=REPLACE_WITH_STAGING_ONLY_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STAGING_ONLY_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
CUSTOMER_TRANSLATION_ENABLED=false
GROUP_TRANSLATION_ENABLED=false
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
