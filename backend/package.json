{
  "name": "multilingual-ai-narration-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend foundation for the Multilingual AI Narration System",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests --max-warnings=0",
    "test": "node --import tsx --test --test-concurrency=1 tests/project-workflow.test.ts tests/auth.test.ts tests/project-media.test.ts tests/transcription.test.ts tests/translation.test.ts tests/tts.test.ts tests/media-processing.test.ts tests/admin-api.test.ts",
    "test:workflow": "node --import tsx --test tests/project-workflow.test.ts",
    "test:tts-terminal": "node --import tsx --test tests/tts-terminal.test.ts tests/project-workflow.test.ts",
    "test:profile": "node --import tsx --test tests/profile-name.test.ts",
    "test:filename": "node --import tsx --test tests/filename-encoding.test.ts",
    "test:stt-debug": "node --import tsx --test tests/stt-debug.test.ts",
    "test:gemini": "node --import tsx --test tests/gemini-stt.test.ts tests/stt-debug.test.ts",
    "test:gemini-translation": "node --import tsx --test tests/gemini-translation.test.ts tests/translation-mock.test.ts",
    "test:group-translation": "node --import tsx --test tests/group-translation.test.ts tests/gemini-translation.test.ts tests/translation-mock.test.ts",
    "test:source-media": "node --import tsx --test tests/source-media.test.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:voices": "tsx src/scripts/seed-voice-catalog.ts",
    "seed:languages": "tsx src/scripts/seed-language-catalog.ts",
    "test:language-catalog": "node --import tsx --test tests/language-catalog.test.ts"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.0",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=20"
  }
}
