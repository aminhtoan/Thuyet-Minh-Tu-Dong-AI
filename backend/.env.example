PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/multilingual_ai_narration?retryWrites=true&w=majority
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200
JWT_ACCESS_SECRET=<replace-with-strong-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<replace-with-different-strong-secret>
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_SEED_NAME=<admin-name>
ADMIN_SEED_EMAIL=<admin-email>
ADMIN_SEED_PASSWORD=<admin-password>
STT_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_STT_MODEL=gemini-3.5-transcribe
OPENAI_API_KEY=<openai-api-key>
STT_MODEL=whisper-1
TRANSLATION_PROVIDER=gemini
# OFF by default; drafts require manual review and a single backend process.
GROUP_TRANSLATION_ENABLED=false
GEMINI_TRANSLATION_MODEL=gemini-3.8-flash
# Normal Customer only: operator-selected BEFORE a fresh eligible attempt.
# No automatic fallback on error; never rearm an existing attempt.
GEMINI_TRANSLATION_FALLBACK_MODEL=gemini-3.6-flash
CUSTOMER_TRANSLATION_MODEL_SELECTION=PRIMARY
# Normal Customer only. Explicit pre-attempt choice; no automatic switching.
CUSTOMER_TRANSLATION_METHOD=GROUPS_V1
# GEMINI_SIMPLE_V1 requires CUSTOMER_TRANSLATION_THINKING=DEFAULT.
# OpenAI translation remains available when TRANSLATION_PROVIDER=openai.
TRANSLATION_MODEL=gpt-4o-mini
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_DEFAULT_VOICE=coral
TTS_AUDIO_FORMAT=mp3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_MS=300000
## Normal Customer GROUPS_V1 rollout (no per-project permits). Keep OFF until isolated ledger integration passes.
CUSTOMER_TRANSLATION_ENABLED=false
CUSTOMER_TRANSLATION_THINKING=DEFAULT
# UTC daily reservations; finite normal-use defaults (not a guaranteed USD billing cap).
# Positive integers only: user 1..1000, global 1..10000; zero/unlimited rejected.
CUSTOMER_TRANSLATION_DAILY_USER_LIMIT=20
CUSTOMER_TRANSLATION_DAILY_GLOBAL_LIMIT=200
