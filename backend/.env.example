PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/multilingual_ai_narration?retryWrites=true&w=majority
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200
JWT_ACCESS_SECRET=<replace-with-strong-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<replace-with-different-strong-secret>
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_SEED_NAME=<admin-name>
ADMIN_SEED_EMAIL=<admin-email>
ADMIN_SEED_PASSWORD=<admin-password>
STT_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_STT_MODEL=gemini-3.5-transcribe
OPENAI_API_KEY=<openai-api-key>
STT_MODEL=whisper-1
TRANSLATION_PROVIDER=openai
TRANSLATION_MODEL=gpt-4o-mini
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_DEFAULT_VOICE=coral
TTS_AUDIO_FORMAT=mp3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_MS=300000
