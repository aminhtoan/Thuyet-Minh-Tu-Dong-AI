# Copy to secrets/backend.env ONLY AFTER reviewing the local setup.
NODE_ENV=development
PORT=8081
MONGODB_URI=mongodb://demo-app:<URL_ENCODED_LOCAL_APP_PASSWORD>@127.0.0.1:27018/multilingual_ai_narration_ui_demo?authSource=multilingual_ai_narration_ui_demo
CORS_ORIGINS=http://localhost:5175
UPLOAD_DIR=uploads-local-demo
MAX_UPLOAD_SIZE_MB=200
JWT_ACCESS_SECRET=<NEW_LOCAL_ACCESS_SECRET>
JWT_REFRESH_SECRET=<DIFFERENT_NEW_LOCAL_REFRESH_SECRET>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# No Atlas URI, Atlas credentials or paid-provider key.
